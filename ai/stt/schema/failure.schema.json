{
  "$defs": {
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "INVALID_REQUEST",
            "AI_TIMEOUT",
            "AUDIO_INVALID",
            "NO_SPEECH",
            "AI_BUSY",
            "AI_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "Error",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "접수 후 실패는 요청 식별 5개를 그대로, 접수 전 실패(인증·파싱)나 형식이 틀린 식별 필드는 null로 둔다(Q12).\n\n키는 생략하지 않는다.",
  "properties": {
    "jobId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Jobid"
    },
    "attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Attempt"
    },
    "requestSchemaVersion": {
      "anyOf": [
        {
          "const": "4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requestschemaversion"
    },
    "inputHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inputhash"
    },
    "contextRevision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Contextrevision"
    },
    "error": {
      "$ref": "#/$defs/Error"
    }
  },
  "required": [
    "jobId",
    "attempt",
    "requestSchemaVersion",
    "inputHash",
    "contextRevision",
    "error"
  ],
  "title": "Failure",
  "type": "object"
}
