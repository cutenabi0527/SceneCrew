            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parenttaskid"
        },
        "role": {
          "enum": [
            "SUPERVISOR",
            "PLANNING",
            "SCHEDULE",
            "STAFFING",
            "GUIDE",
            "REVIEW"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "NEEDS_INFO",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "role",
        "status"
      ],
      "title": "AgentTaskNode",
      "type": "object"
    },
    "AssetPlan": {
      "additionalProperties": false,
