{
    "name": "scenecrew-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24.18.0 <25",
        "npm": ">=11 <12"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "dev:android": "vite --mode android --host 127.0.0.1",
        "build": "npm run typecheck:build && vite build",
        "build:android": "npm run typecheck:build && vite build --mode android",
        "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
        "preview:android": "vite preview --mode android --host 127.0.0.1 --port 4174 --strictPort",
        "typecheck": "tsc --noEmit",
        "typecheck:build": "tsc --noEmit -p tsconfig.build.json",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "fixture": "vite --config vite.fixture.config.ts",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
        "android:add": "npm run build:android && cap add android",
        "android:sync": "npm run build:android && cap sync android",
        "android:open": "cap open android",
        "android:debug": "node tools/android-debug.mjs"
    },
    "dependencies": {
        "@capacitor/android": "8.4.3",
        "@capacitor/app": "8.1.2",
        "@capacitor/browser": "8.0.5",
        "@capacitor/core": "8.4.3",
        "@capacitor/push-notifications": "8.1.3",
        "@fontsource-variable/archivo": "5.3.0",
        "@fontsource/anton": "5.3.0",
        "@fontsource/ibm-plex-sans-kr": "5.3.0",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@tanstack/react-query": "5.104.5",
        "qrcode-generator": "2.0.4",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.0"
    },
    "devDependencies": {
        "@capacitor/cli": "8.4.3",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@types/node": "24.10.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
