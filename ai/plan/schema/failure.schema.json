{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "READ_CONTEXT_CHANGED",
            "AI_TIMEOUT",
            "AI_REVIEW_FAILED",
            "AI_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorBody",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "접수 뒤 실패는 식별·입력 기준을 그대로 반환한다.\n\n인증/JSON 파싱 실패처럼 식별을 신뢰할 수 없는 사전 오류만 INVALID_REQUEST로 모르는 값을 null로 둔다.",
  "properties": {
    "jobId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Jobid"
    },
    "attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Attempt"
    },
    "requestSchemaVersion": {
      "anyOf": [
        {
          "const": "4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requestschemaversion"
    },
    "inputHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inputhash"
    },
    "contextRevision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Contextrevision"
    },
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "jobId",
    "attempt",
    "requestSchemaVersion",
    "inputHash",
    "contextRevision",
    "error"
  ],
  "title": "PlanFailure",
  "type": "object"
}
