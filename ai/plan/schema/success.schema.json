          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "title": "Taskid",
          "type": "string"
        },
        "parentTaskId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,40}$",
              "type": "string"
