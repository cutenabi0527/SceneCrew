              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
