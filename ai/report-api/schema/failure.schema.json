{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "AI_TIMEOUT",
            "AI_UNAVAILABLE"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorBody",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Jobid"
    },
    "attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Attempt"
    },
    "requestSchemaVersion": {
      "anyOf": [
        {
          "const": "4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requestschemaversion"
    },
    "inputHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inputhash"
    },
    "contextRevision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Contextrevision"
    },
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "jobId",
    "attempt",
    "requestSchemaVersion",
    "inputHash",
    "contextRevision",
    "error"
  ],
  "title": "AnalyzeFailure",
  "type": "object"
}
